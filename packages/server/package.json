{
	"name": "@earendil-works/pi-server",
	"version": "1.3.0",
	"description": "HTTP server for the pi coding agent: opencode-compatible API, crash resume and idle shutdown",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"pi-server": "dist/cli.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"source": "./src/client.ts",
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"pi",
		"coding-agent",
		"server",
		"opencode"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0"
	},
	"devDependencies": {
		"shx": "0.3.4",
		"vitest": "4.1.11"
	}
}
