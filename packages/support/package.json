{
	"name": "@earendil-works/pi-support",
	"version": "1.3.0",
	"description": "Shared support modules of the pi coding agent and the pi client",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"pi",
		"coding-agent",
		"client",
		"shared"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/support"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"cross-spawn": "7.0.6",
		"semver": "7.8.5",
		"undici": "8.10.2"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/semver": "7.7.1",
		"shx": "0.3.4"
	}
}
