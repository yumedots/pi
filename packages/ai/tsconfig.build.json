{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
		"outDir": "./dist",
		"rootDir": "./src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts", "src/**/*.d.ts"]
}