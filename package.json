{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox",
		"packages/coding-agent/examples/extensions/gondolin"
	],
	"scripts": {
		"clean": "bun run --workspaces --if-present --sequential clean",
		"build": "bun scripts/build-workspaces.mjs",
		"build:offline": "bun scripts/build-workspaces.mjs --offline",
		"build:native:darwin": "bun run --filter '@earendil-works/pi-tui' build:native:darwin",
		"build:native:linux": "bun run --filter '@earendil-works/pi-tui' build:native:linux",
		"build:native:win32": "bun run --filter '@earendil-works/pi-tui' build:native:win32",
		"check": "node scripts/biome-check.mjs --write && bun run check:pinned-deps && bun run check:runtime-deps && bun run check:ts-imports && bun run check:entry-graphs && bun run check:install-lock:coding-agent && bun run check:lockfiles && tsc --noEmit && bun run check:browser-smoke",
		"check:browser-smoke": "bun scripts/check-browser-smoke.mjs",
		"check:pinned-deps": "bun scripts/check-pinned-deps.mjs",
		"check:runtime-deps": "node scripts/check-runtime-deps.mjs",
		"check:package-install": "node scripts/check-package-install.mjs",
		"check:install-lock:coding-agent": "bun scripts/generate-coding-agent-install-lock.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"check:entry-graphs": "bun scripts/check-entry-graphs.mjs",
		"check:lockfiles": "bun scripts/check-lockfiles-agree.mjs",
		"generate:models": "bun run --filter '@earendil-works/pi-ai' generate-models",
		"hydrate:model-data": "bun run --filter '@earendil-works/pi-ai' hydrate-model-data",
		"check:model-data": "bun run --filter '@earendil-works/pi-ai' check:model-data",
		"generate:model-catalog": "bun run --filter '@earendil-works/pi-ai' generate-model-catalog",
		"diff:model-catalog": "node scripts/diff-model-catalog.mjs",
		"update:model-catalog-pin": "node scripts/update-model-catalog-pin.mjs",
		"eval": "bun run --filter '@earendil-works/pi-evals' eval --",
		"check:model-catalog": "node scripts/publish-model-catalog.mjs --input .artifacts/model-catalog --dry-run",
		"check:model-catalog-compat": "node scripts/check-model-catalog-compat.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "bun run test:scripts && bun run --workspaces --if-present --sequential test",
		"test:scripts": "node --test scripts/*.test.mjs scripts/*.test.ts",
		"test:mcp-conformance": "node packages/coding-agent/test/mcp-conformance/run.ts",
		"version:patch": "npm version patch --workspaces --no-git-tag-version --no-workspaces-update && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts && bun pm migrate",
		"version:minor": "npm version minor --workspaces --no-git-tag-version --no-workspaces-update && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts && bun pm migrate",
		"version:major": "npm version major --workspaces --no-git-tag-version --no-workspaces-update && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts && bun pm migrate",
		"version:set": "npm version --workspaces --no-workspaces-update",
		"prepublishOnly": "bun run clean && bun run build && bun run check",
		"publish": "bun run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "bun run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"pack:packages": "node scripts/pack-packages.mjs",
		"install-lock:coding-agent": "bun scripts/generate-coding-agent-install-lock.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:fix-links": "node scripts/release-notes.mjs fix-github-releases",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@biomejs/wasm-nodejs": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"pnpm": "11.15.1",
		"shx": "0.3.4",
		"typescript": "7.0.2",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
